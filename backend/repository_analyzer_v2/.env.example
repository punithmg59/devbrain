# ==========================================
# DevBrain Repository Analyzer Configuration
# ==========================================

# Environment Settings
# Options: development, testing, production
ENVIRONMENT=development
DEBUG_MODE=true

# Database Configuration (Required)
# Must be a valid PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/devbrain

# Worker & Performance Configuration
# Number of parallel processing workers (Min: 1, Max: 128)
WORKER_COUNT=4
# Maximum memory per worker in MB
MAX_MEMORY_MB=1024

# File Processing Limits
# Maximum file size to process in KB
MAX_FILE_SIZE_KB=5000
# Timeout for processing a single file in seconds
FILE_TIMEOUT_SECONDS=30

# Supported Languages
# JSON array of languages to analyze
SUPPORTED_LANGUAGES=["python", "typescript", "javascript", "java", "go", "csharp"]

# Observability
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Enable/disable metrics collection
METRICS_ENABLED=true

# Cache Configuration
CACHE__ENABLED=true
CACHE__TTL_SECONDS=3600
# CACHE__REDIS_URL=redis://localhost:6379/0
